root = true

[*]
indent_style = tab
tab_width = 4
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{bat,cmd,ps1,sln,vcxproj,vcxproj.filters}]
end_of_line = crlf

# Vendored code keeps its own style. Never edit it.
[vendor/**]
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
