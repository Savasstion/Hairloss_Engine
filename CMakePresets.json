{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": 
      {
         "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },

    {
      "name": "ninja-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "ninja-x64",
      "displayName": "Ninja x64",
      "inherits": "ninja-base",
      "architecture": { "value": "x64", "strategy": "external" }
    },
    {
      "name": "ninja-x86",
      "displayName": "Ninja x86",
      "inherits": "ninja-base",
      "architecture": { "value": "x86", "strategy": "external" }
    },

    {
      "name": "vs2022-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "vs2022-x64",
      "displayName": "Visual Studio 2022 x64",
      "inherits": "vs2022-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "vs2022-x86",
      "displayName": "Visual Studio 2022 x86",
      "inherits": "vs2022-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    },

    {
      "name": "vs2026-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "inherits": "vs2026-base",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "vs2026-x86",
      "displayName": "Visual Studio 2026 x86",
      "inherits": "vs2026-base",
      "architecture": { "value": "Win32", "strategy": "set" }
    }
  ],

  "buildPresets": [
    { "name": "ninja-x64-debug",   "configurePreset": "ninja-x64",  "configuration": "Debug" },
    { "name": "ninja-x64-release", "configurePreset": "ninja-x64",  "configuration": "Release" },
    { "name": "ninja-x86-debug",   "configurePreset": "ninja-x86",  "configuration": "Debug" },
    { "name": "ninja-x86-release", "configurePreset": "ninja-x86",  "configuration": "Release" },

    { "name": "vs2022-x64-debug",   "configurePreset": "vs2022-x64", "configuration": "Debug" },
    { "name": "vs2022-x64-release", "configurePreset": "vs2022-x64", "configuration": "Release" },
    { "name": "vs2022-x86-debug",   "configurePreset": "vs2022-x86", "configuration": "Debug" },
    { "name": "vs2022-x86-release", "configurePreset": "vs2022-x86", "configuration": "Release" },

    { "name": "vs2026-x64-debug",   "configurePreset": "vs2026-x64", "configuration": "Debug" },
    { "name": "vs2026-x64-release", "configurePreset": "vs2026-x64", "configuration": "Release" },
    { "name": "vs2026-x86-debug",   "configurePreset": "vs2026-x86", "configuration": "Debug" },
    { "name": "vs2026-x86-release", "configurePreset": "vs2026-x86", "configuration": "Release" }
  ]
}